runs/
runs_*/

# evaluation artifacts (regenerated by scripts/run_eval.sh)
eval/*.json
eval/*.jsonl
eval/3b/
eval/17b/

# personal working notes — not part of the deliverable
RESULTS.md
ANALYSIS.md
DESIGN.md

# large test-set intermediates (only the deliverable files are committed)
testset/attackqa_survival.jsonl
testset/attackqa_survival_stats.json
testset/verification.jsonl

# logs / OS
*.log
.DS_Store
