# secrets / local config
.env
.dev.vars
.dev.vars.*

# python
__pycache__/
*.pyc
*.egg-info/
venv/
.venv/

# model weights and large external inputs (fetched, not committed)
models/
raw/
data/attackqa.parquet

# knowledge base + index are built from source (scripts/build_kb.sh, rag.index)
kb/
index/
faiss_index/
