# Copy to .env and fill in to use the hosted Cloudflare Worker backend.
# Leave unset (and set LLM_BACKEND=local) to use a local llama.cpp server instead.

# Hosted backend (Cloudflare Worker that routes to Workers AI models)
WORKER_URL=
WORKER_AUTH_KEY=

# Backend selector:
#   local  -> OpenAI-compatible llama.cpp server on http://127.0.0.1:8080 (no API cost)
#   unset  -> the hosted Worker above is used
# LLM_BACKEND=local
